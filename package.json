{
  "name": "kaldareth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run preview -- --port 4173 --strictPort --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --config vite.frame.config.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.mjs",
    "check:progression": "node scripts/progression-check.mjs",
    "check:balance": "node scripts/balance-check.mjs",
    "check:econ": "node scripts/econ-check.mjs",
    "check:sdk": "node scripts/check-sdk-boundary.mjs",
    "vendor:sdk": "node scripts/vendor-sdk.mjs",
    "verify": "npm run typecheck && npm run lint && npm run validate:content && npm run check:progression && npm run check:balance && npm run check:econ && npm run test && npm run build && npm run check:sdk && npm run test:e2e",
    "verify:content": "npm run validate:content -- --strict"
  },
  "dependencies": {
    "@rarefriends/friendsdk": "file:vendor/rarefriends-friendsdk-0.1.2.tgz",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
